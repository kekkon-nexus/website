{
	"$schema": "https://www.schemastore.org/tsconfig",
	"extends": ["@kekkon-nexus/config/ts", "@kekkon-nexus/config/ts/strict"],
	"compilerOptions": {
		"skipLibCheck": true,

		"paths": {
			"@/*": ["./src/*"]
		},

		"types": ["vite/client", "@cloudflare/workers-types/experimental"],
		"jsx": "react-jsx",
		"jsxImportSource": "hono/jsx"
	}
}
